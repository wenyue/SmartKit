{
  "servers": [
    {
      "id": "playwright",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless"
      ],
      "harnesses": [
        "codex",
        "cursor",
        "copilot",
        "qoder"
      ],
      "tools": [
        "*"
      ],
      "readiness": {
        "checks": [
          {
            "kind": "runtime-version",
            "runtime": "node",
            "minimum": "18.0.0"
          },
          {
            "kind": "command-exists",
            "command": "npx"
          }
        ]
      }
    },
    {
      "id": "codegraph",
      "transport": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "harnesses": [
        "codex",
        "cursor",
        "copilot",
        "qoder"
      ],
      "tools": [
        "*"
      ],
      "readiness": {
        "checks": [
          {
            "kind": "command-exists",
            "command": "codegraph"
          }
        ]
      }
    },
    {
      "id": "openwiki",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "openwiki@0.9.0",
        "mcp",
        "--host",
        "smartkit"
      ],
      "harnesses": [
        "codex",
        "cursor",
        "copilot",
        "qoder"
      ],
      "tools": [
        "*"
      ],
      "readiness": {
        "checks": [
          {
            "kind": "runtime-version",
            "runtime": "node",
            "minimum": "22.22.0"
          },
          {
            "kind": "command-exists",
            "command": "npx"
          }
        ]
      }
    }
  ]
}
