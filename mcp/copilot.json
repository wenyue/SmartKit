{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless"
      ],
      "tools": [
        "*"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "tools": [
        "*"
      ]
    },
    "openwiki": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "openwiki@0.9.0",
        "mcp",
        "--host",
        "smartkit"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
