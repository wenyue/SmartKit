# Preserve unknown resources; explicitly recognized text formats use LF on every platform.
* -text
*.md text=auto eol=lf
*.html text=auto eol=lf
*.py text=auto eol=lf
*.json text=auto eol=lf
*.yaml text=auto eol=lf
*.yml text=auto eol=lf
*.toml text=auto eol=lf
*.svg text=auto eol=lf
*.txt text=auto eol=lf
*.css text=auto eol=lf
*.js text=auto eol=lf
*.ts text=auto eol=lf
*.sh text=auto eol=lf
*.ps1 text=auto eol=lf
# Snapshot and license hashes own exact bytes, including opaque assets with text suffixes.
skills/** -text
licenses/** -text
# Patch bytes participate in the external Skill lock on every platform.
vendor/patches/** text eol=lf
