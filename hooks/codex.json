{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/runtime/recommended-tools/check_recommended_tools.sh\" hook --harness codex",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\runtime\\recommended-tools\\check_recommended_tools.ps1\" hook --harness codex",
            "timeout": 30,
            "statusMessage": "Checking Python and daily readiness and session CodeGraph health"
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/runtime/rules/dispatch.sh\" --harness codex --event session",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\runtime\\rules\\dispatch.ps1\" --harness codex --event session",
            "timeout": 30,
            "additionalContextLimit": 50000,
            "statusMessage": "Loading SmartKit plugin rules"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/runtime/local_web/dispatch.sh\" hook --harness codex",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\runtime\\local_web\\dispatch.ps1\" hook --harness codex",
            "timeout": 15,
            "statusMessage": "Starting shared SmartKit HTTP service"
          }
        ]
      }
    ]
  }
}
