{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "setupVersion": {"type": "string", "description": "SmartKit release used by the last successful full setup; written only by finish.", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "ruleEntry": {
      "enum": ["AGENTS.md", "AGENTS.local.md"],
      "default": "AGENTS.md",
      "description": "Project rules index entry; only its Project rules section is managed."
    },
    "maintenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": ["local", "local-only"],
              "description": "local: project shared through business Git; local-only: this machine only, locally excluded from business Git."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "repository",
            "branch",
            "entry"
          ],
          "properties": {
            "mode": {
              "const": "repository",
              "description": "Separate personal configuration repository; target configuration is locally excluded from business Git."
            },
            "repository": {
              "type": "string",
              "description": "GitHub owner/repo for github.com, or a credential-free HTTPS repository URL for GitHub Enterprise; an optional URL .git suffix is accepted.",
              "pattern": "^(?:(?!.*\\.git$)[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9][A-Za-z0-9_.-]*|(?!.*\\.git\\.git$)https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*/[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9][A-Za-z0-9_.-]*)$"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "entry": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      ]
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "key",
          "value"
        ],
        "properties": {
          "path": {
            "enum": [
              ".codex/config.toml",
              ".cursor/cli.json"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ]
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "include"],
        "properties": {
          "source": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "ref": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {"$ref": "#/$defs/projectAgent"}
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "harnesses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "cursor", "copilot", "qoder"]}
          },
          "command": {"type": "string", "minLength": 1},
          "args": {"$ref": "#/$defs/stringArray"},
          "cwd": {"type": "string", "minLength": 1},
          "env": {"$ref": "#/$defs/environmentNames"},
          "url": {"type": "string", "pattern": "^https?://"},
          "overrides": {
            "type": "array",
            "items": {"$ref": "#/$defs/mcpOverride"}
          },
          "readiness": {"$ref": "#/$defs/mcpReadiness"}
        },
        "oneOf": [
          {"required": ["command"], "not": {"required": ["url"]}},
          {
            "required": ["url"],
            "not": {"anyOf": [
              {"required": ["command"]}, {"required": ["args"]},
              {"required": ["cwd"]}, {"required": ["env"]}
            ]}
          }
        ]
      }
    }
  },
  "$defs": {
    "projectAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "harnesses"],
      "anyOf": [{"required": ["source"]}, {"properties": {"harnesses": {"additionalProperties": {"required": ["native_source"]}}}}],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "source": {
          "type": "string",
          "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.md$"
        },
        "description": {"type": "string", "minLength": 1},
        "harnesses": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "codex": {"$ref": "#/$defs/codexAgent"},
            "cursor": {"$ref": "#/$defs/cursorAgent"},
            "copilot": {"$ref": "#/$defs/copilotAgent"},
            "qoder": {"$ref": "#/$defs/qoderAgent"}
          }
        }
      }
    },
    "codexAgent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["sandbox_mode"], "not": {"required": ["native_source"]}}, {"required": ["native_source"], "maxProperties": 1}],
      "properties": {
        "native_source": {"type": "string", "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.codex\\.toml$"},
        "model": {"type": "string", "minLength": 1},
        "model_reasoning_effort": {"type": "string", "minLength": 1},
        "sandbox_mode": {"type": "string", "minLength": 1}
      }
    },
    "cursorAgent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["readonly"], "not": {"required": ["native_source"]}}, {"required": ["native_source"], "maxProperties": 1}],
      "properties": {
        "native_source": {"type": "string", "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.cursor\\.md$"},
        "model": {"type": "string", "minLength": 1},
        "readonly": {"type": "boolean"}
      }
    },
    "copilotAgent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["disable_model_invocation"], "not": {"required": ["native_source"]}}, {"required": ["native_source"], "maxProperties": 1}],
      "properties": {
        "native_source": {"type": "string", "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.copilot\\.md$"},
        "model": {"type": "string", "minLength": 1},
        "disable_model_invocation": {"type": "boolean"}
      }
    },
    "qoderAgent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"not": {"required": ["native_source"]}}, {"required": ["native_source"], "maxProperties": 1}],
      "properties": {
        "native_source": {"type": "string", "pattern": "^\\.agents/agents/[a-z0-9][a-z0-9-]*\\.qoder\\.md$"},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "environmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "mcpOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "set"],
      "properties": {
        "when": {"$ref": "#/$defs/mcpOverrideSelector"},
        "set": {"$ref": "#/$defs/mcpOverrideValues"}
      }
    },
    "mcpOverrideSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "cursor", "copilot", "qoder"]}
        },
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux"]}
        }
      }
    },
    "mcpOverrideValues": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "args": {"$ref": "#/$defs/stringArray"},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"$ref": "#/$defs/environmentNames"},
        "url": {"type": "string", "pattern": "^https?://"}
      }
    },
    "mcpReadiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "cursor", "copilot", "qoder"]}
        },
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux"]}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/mcpReadinessCheck"}
        }
      }
    },
    "mcpReadinessCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {"const": "command-exists"},
            "command": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "runtime", "minimum"],
          "properties": {
            "kind": {"const": "runtime-version"},
            "runtime": {"const": "node"},
            "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "workspace-path"},
            "path": {"type": "string", "minLength": 1},
            "executable": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "environment-variable"},
            "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      ]
    }
  }
}
